[Desktop Entry]
Type=Application
Name=Nebel einrichten
Comment=Cinnamon-Desktop „Nebel“ für diesen Benutzer einrichten oder entfernen
Exec=nebel-einrichten
Icon=preferences-desktop-theme
Terminal=false
Categories=Settings;DesktopSettings;
Keywords=Theme;Nebel;Plank;Desklet;Cinnamon;
Actions=uninstall;

[Desktop Action uninstall]
Name=Nebel entfernen
Exec=nebel-einrichten --uninstall
