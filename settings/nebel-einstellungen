class Page(Gtk.ScrolledWindow):
    def __init__(self):
        super().__init__(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                           margin_top=18, margin_bottom=18, margin_start=24, margin_end=24)
        self.add(self.box)
        self.grid = None
        self._row = 0

    def section(self, title):
        lbl = Gtk.Label(xalign=0)
        lbl.set_markup("<b>%s</b>" % GLib.markup_escape_text(title))
        frame = Gtk.Frame()
        self.grid = Gtk.Grid(column_spacing=24, row_spacing=10, margin_top=12, margin_bottom=12,
                             margin_start=14, margin_end=14)
        frame.add(self.grid)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        v.pack_start(lbl, False, False, 0)
        v.pack_start(frame, False, False, 0)
        self.box.pack_start(v, False, False, 0)
        self._row = 0
        return self.grid

    def row(self, label, widget, hint=None):
        lbl = Gtk.Label(label=label, xalign=0, hexpand=True)
        lbl.set_line_wrap(True)
        widget.set_halign(Gtk.Align.END)
        widget.set_valign(Gtk.Align.CENTER)
        self.grid.attach(lbl, 0, self._row, 1, 1)
        self.grid.attach(widget, 1, self._row, 1, 1)
        self._row += 1
        if hint:
            h = Gtk.Label(xalign=0)
            h.set_markup("<small>%s</small>" % GLib.markup_escape_text(hint))
            h.get_style_context().add_class("dim-label")
            self.grid.attach(h, 0, self._row, 2, 1)
            self._row += 1
        return widget

    def note(self, text):
        lbl = Gtk.Label(label=text, xalign=0)
        lbl.get_style_context().add_class("dim-label")
        self.box.pack_start(lbl, False, False, 0)

    # --- gsettings-Bausteine
    def g_switch(self, s, key, label):
        w = Gtk.Switch(active=s.get_boolean(key))
        w.connect("notify::active", lambda w, _p: s.set_boolean(key, w.get_active()))
        return self.row(label, w)

    def g_spin(self, s, key, label, lo, hi, step=1, unit="", also=()):
        w = Gtk.SpinButton.new_with_range(lo, hi, step)
        w.set_value(s.get_int(key))

        def apply():
            for o in (s,) + tuple(also):
                o.set_int(key, w.get_value_as_int())
        w.connect("value-changed", lambda w: debounce(w, apply))
        return self.row(label + (" (%s)" % unit if unit else ""), w)

    def g_combo(self, s, key, label, options, also=()):
        """options: Liste (wert, anzeige); also: weitere Settings-Objekte mit gleichem Schlüssel."""
        w = Gtk.ComboBoxText()
        cur = s.get_string(key)
        if cur and cur not in [v for v, _t in options]:
            options = [(cur, cur)] + list(options)
        for v, t in options:
            w.append(v, t)
        w.set_active_id(cur)

        def changed(w):
            v = w.get_active_id()
            if v is not None:
                for o in (s,) + tuple(also):
                    o.set_string(key, v)
        w.connect("changed", changed)
        return self.row(label, w)

    def g_font(self, s, key, label):
        w = Gtk.FontButton(font=s.get_string(key), use_font=True)
        w.connect("font-set", lambda w: s.set_string(key, w.get_font()))
        return self.row(label, w)

    # --- Xlet-Einstellungen nach dessen settings-schema
    def xlet(self, xs, kind, title):
        if title:
            self.section(title)
        widgets, deps = {}, []
        for key, e in xs.data.items():
            if not isinstance(e, dict) or "type" not in e:
                continue
            t = e["type"]
            desc = e.get("description", key)
            if t == "header":
                if self.grid is None or self._row:
                    self.section(desc)
                continue
            if self.grid is None:
                self.section(xs.uuid)
            if t in ("switch", "checkbox"):
                w = Gtk.Switch(active=bool(xs.get(key)))
                w.connect("notify::active", lambda w, _p, k=key: xs.set(k, w.get_active()))
            elif t in ("spinbutton", "scale"):
                lo, hi, st = e.get("min", 0), e.get("max", 100), e.get("step", 1)
                isint = all(float(x).is_integer() for x in (lo, hi, st))
                if t == "scale":
                    w = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, st)
                    w.set_size_request(260, -1)
                    w.set_digits(0 if isint else 2)
                    w.set_value_pos(Gtk.PositionType.RIGHT)
                else:
                    w = Gtk.SpinButton.new_with_range(lo, hi, st)
                    if not isint:
                        w.set_digits(len(str(st).split(".")[-1]))
                w.set_value(xs.get(key))

                def changed(w, k=key, isint=isint):
                    debounce(w, lambda: xs.set(k, int(round(w.get_value())) if isint else round(w.get_value(), 3)))
                w.connect("value-changed", changed)
                if e.get("units"):
                    desc = "%s (%s)" % (desc, e["units"])
            elif t == "combobox":
                w = Gtk.ComboBoxText()
                for lbl, val in e.get("options", {}).items():
                    w.append(json.dumps(val), lbl)
                w.set_active_id(json.dumps(xs.get(key)))
                w.connect("changed", lambda w, k=key: w.get_active_id() and xs.set(k, json.loads(w.get_active_id())))
            elif t == "entry":
                w = Gtk.Entry(text=str(xs.get(key) or ""), width_chars=28)
                w.connect("changed", lambda w, k=key: debounce(w, lambda: xs.set(k, w.get_text()), 600))
            elif t == "button":
                w = Gtk.Button(label=desc)
                w.connect("clicked", lambda _w, cb=e.get("callback", ""):
                          cinnamon_call("activateCallback", (cb, xs.uuid, xs.instance), "(sss)"))
                desc = ""
            elif t == "keybinding":
                acc = (xs.get(key) or "").split("::")[0]
                k, m = Gtk.accelerator_parse(acc)
                w = Gtk.Label(label=Gtk.accelerator_get_label(k, m) if k else (acc or "–"))
                desc = "%s – %s" % (desc, _("Ändern über „Alle Optionen …“"))
            else:
                continue
            self.row(desc, w)
            widgets[key] = w
            dep = e.get("dependency")
            if isinstance(dep, str) and dep.lstrip("!") in xs.data:
                deps.append((w, dep))

        def refresh(*_a):
            for w, dep in deps:
                src = widgets.get(dep.lstrip("!"))
                on = src.get_active() if isinstance(src, Gtk.Switch) else bool(xs.get(dep.lstrip("!")))
                w.set_sensitive(on != dep.startswith("!"))
        for _w, dep in deps:
            src = widgets.get(dep.lstrip("!"))
            if isinstance(src, Gtk.Switch):
                src.connect("notify::active", refresh)
        refresh()

        def open_all(_w):
            xs._follow()
            subprocess.Popen(["xlet-settings", kind, xs.uuid] + ([] if kind == "extension" else ["-i", xs.instance]))
        more = Gtk.Button(label=_("Alle Optionen …"), halign=Gtk.Align.END)
        more.connect("clicked", open_all)
        self.box.pack_start(more, False, False, 0)
        self.grid = None


