def find_installer():
    """Zuletzt benutztes install.sh (Paket oder Repository), sonst das aus dem Paket."""
    cands = []
    try:
        with open(os.path.join(CONF_DIR, "install-path"), encoding="utf-8") as f:
            cands.append(f.read().strip())
    except OSError:
        pass
    cands.append("/usr/share/cinnamon-theme-nebel/install.sh")
    return next((c for c in cands if c and os.path.isfile(c)), None)


