# ------------------------------------------------------------------ Hilfen
def gsettings(schema_id, path=None):
    src = Gio.SettingsSchemaSource.get_default()
    if src is None or src.lookup(schema_id, True) is None:
        return None
    return Gio.Settings.new_with_path(schema_id, path) if path else Gio.Settings.new(schema_id)


def cinnamon_call(method, args, sig):
    try:
        Gio.bus_get_sync(Gio.BusType.SESSION, None).call_sync(
            "org.Cinnamon", "/org/Cinnamon", "org.Cinnamon", method,
            GLib.Variant(sig, args), None, Gio.DBusCallFlags.NONE, 2000, None)
    except GLib.Error as e:
        print("D-Bus:", e.message)


def theme_names(kind, check):
    """Namen aller Themes (kind 'themes' oder 'icons'), die check(pfad) erfüllen."""
    if kind == "themes":
        bases = [os.path.join(HOME, ".themes"), os.path.join(HOME, ".local/share/themes"), "/usr/share/themes"]
    else:
        bases = [os.path.join(HOME, ".icons"), os.path.join(HOME, ".local/share/icons"), "/usr/share/icons"]
    names = set()
    for base in bases:
        try:
            for n in os.listdir(base):
                if check(os.path.join(base, n)):
                    names.add(n)
        except OSError:
            pass
    return sorted(names, key=str.lower)


def is_icon_theme(p):
    idx = os.path.join(p, "index.theme")
    if not os.path.isfile(idx) or os.path.isdir(os.path.join(p, "cursors")):
        return False
    try:
        with open(idx, encoding="utf-8", errors="ignore") as f:
            return "Directories=" in f.read()
    except OSError:
        return False


class XletSettings:
    """Einstellungsdatei eines Cinnamon-Xlets; Änderungen werden Cinnamon gemeldet."""

    def __init__(self, uuid, instance, desklet=False):
        self.uuid, self.instance, self.desklet = uuid, str(instance), desklet
        self.path = os.path.join(SPICES, uuid, self.instance + ".json")
        with open(self.path, encoding="utf-8") as f:
            self.data = json.load(f)

    def _follow(self):
        # Desklets können neu angelegt werden (andere Nummer), während das Programm läuft
        if self.desklet:
            inst = desklet_instance(self.uuid)
            if inst and inst != self.instance:
                self.instance = inst
                self.path = os.path.join(SPICES, self.uuid, inst + ".json")

    def get(self, key):
        e = self.data.get(key, {})
        return e.get("value", e.get("default"))

    def set(self, key, value):
        self._follow()
        try:
            with open(self.path, encoding="utf-8") as f:
                self.data = json.load(f)
        except (OSError, ValueError):
            pass
        self.data[key]["value"] = value
        text = json.dumps(self.data, indent=4, ensure_ascii=False)
        try:
            os.remove(self.path)
        except OSError:
            pass
        with open(self.path, "w", encoding="utf-8") as f:
            f.write(text)
        cinnamon_call("updateSetting", (self.uuid, self.instance, key, json.dumps(value)), "(ssss)")


def _enabled(key):
    s = gsettings("org.cinnamon")
    return s.get_strv(key) if s else []


def desklet_instance(uuid):
    for d in _enabled("enabled-desklets"):
        p = d.split(":")
        if len(p) > 1 and p[0] == uuid:
            return p[1]
    return None


def applet_instance(uuid):
    for d in _enabled("enabled-applets"):
        p = d.split(":")
        if len(p) > 4 and p[3] == uuid:
            return p[4]
    return None


def debounce(widget, fn, ms=250):
    if getattr(widget, "_nebel_t", 0):
        GLib.source_remove(widget._nebel_t)

    def run():
        widget._nebel_t = 0
        fn()
        return GLib.SOURCE_REMOVE
    widget._nebel_t = GLib.timeout_add(ms, run)


