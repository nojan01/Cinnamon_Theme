def page_setup():
    p = Page()
    inst = find_installer()
    if not inst:
        p.note(_("Installationsprogramm nicht gefunden."))
        return p
    try:
        with open(os.path.join(os.path.dirname(inst), "VERSION"), encoding="utf-8") as f:
            version = f.read().strip()
    except OSError:
        version = ""
    head = Gtk.Label(xalign=0)
    head.set_line_wrap(True)
    head.set_markup("<big><b>Nebel %s</b></big>\n<small>%s</small>" % (
        GLib.markup_escape_text(version),
        GLib.markup_escape_text(_("Vorherige Einstellungen werden gesichert und lassen sich mit „Alles entfernen“ zurückholen."))))
    p.box.pack_start(head, False, False, 0)

    p.section(_("Bausteine"))
    checks, states = {}, {}

    def read_list():
        env = {k: v for k, v in os.environ.items() if k != "DISPLAY"}  # keine zenity-Dialoge
        out = subprocess.run(["bash", inst, "--list"], capture_output=True, text=True, env=env).stdout
        return [l.split("\t") for l in out.splitlines() if l.count("\t") == 2]

    comps = read_list()
    nothing = not any(i == "1" for _c, _d, i in comps)
    for c, desc, done in comps:
        cb = Gtk.CheckButton(label=desc, active=nothing)
        st = Gtk.Label(xalign=1)
        st.get_style_context().add_class("dim-label")
        p.grid.attach(cb, 0, p._row, 1, 1)
        p.grid.attach(st, 1, p._row, 1, 1)
        p._row += 1
        checks[c], states[c] = cb, st

    def refresh_states():
        for c, _d, done in read_list():
            if c in states:
                states[c].set_text("✓ " + _("eingerichtet") if done == "1" else "")
    refresh_states()

    bar = Gtk.Box(spacing=8)
    b_all = Gtk.Button(label=_("Alles auswählen"))
    b_all.connect("clicked", lambda _w: [cb.set_active(True) for cb in checks.values()])
    b_run = Gtk.Button(label=_("Ausgewählte einrichten"))
    b_run.get_style_context().add_class("suggested-action")
    b_rm = Gtk.Button(label=_("Alles entfernen …"))
    b_rm.get_style_context().add_class("destructive-action")
    status = Gtk.Label(xalign=0, hexpand=True)
    bar.pack_start(status, True, True, 0)
    for b in (b_all, b_rm, b_run):
        bar.pack_start(b, False, False, 0)
    p.box.pack_start(bar, False, False, 0)

    buf = Gtk.TextBuffer()
    view = Gtk.TextView(buffer=buf, editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR)
    sc = Gtk.ScrolledWindow(min_content_height=180)
    sc.add(view)
    exp = Gtk.Expander(label=_("Protokoll"))
    exp.add(sc)
    p.box.pack_start(exp, False, False, 0)
    ansi = re.compile(r"\x1b\[[0-9;]*m")

    def run(args):
        for b in (b_all, b_run, b_rm):
            b.set_sensitive(False)
        status.set_text(_("Läuft …"))
        buf.set_text("")
        exp.set_expanded(True)
        launcher = Gio.SubprocessLauncher.new(Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        launcher.setenv("NEBEL_FROM_SETTINGS", "1", True)
        proc = launcher.spawnv(["bash", inst] + args)
        stream = Gio.DataInputStream.new(proc.get_stdout_pipe())

        def on_line(st, res):
            line, _n = st.read_line_finish_utf8(res)
            if line is None:
                proc.wait_async(None, on_exit)
                return
            buf.insert(buf.get_end_iter(), ansi.sub("", line) + "\n")
            view.scroll_to_iter(buf.get_end_iter(), 0, False, 0, 1)
            st.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

        def on_exit(pr, res):
            pr.wait_finish(res)
            code = pr.get_exit_status()
            status.set_text(_("Fertig.") if code == 0 else _("Fehler (Code %d).") % code)
            for b in (b_all, b_run, b_rm):
                b.set_sensitive(True)
            refresh_states()
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

    def do_run(_w):
        sel = [c for c, cb in checks.items() if cb.get_active()]
        if sel:
            run(["--components", ",".join(sel)])
    b_run.connect("clicked", do_run)

    def do_remove(_w):
        d = Gtk.MessageDialog(transient_for=p.get_toplevel(), modal=True, message_type=Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.YES_NO,
                              text=_("Alle Einstellungen von Nebel rückgängig machen und den vorherigen Zustand wiederherstellen?"))
        ok = d.run() == Gtk.ResponseType.YES
        d.destroy()
        if ok:
            run(["--uninstall"])
    b_rm.connect("clicked", do_remove)
    p.set_up_done = not nothing
    return p


def page_appearance():
    p = Page()
    ci = gsettings("org.cinnamon.desktop.interface")
    gn = gsettings("org.gnome.desktop.interface")
    also = (gn,) if gn else ()
    ct = gsettings("org.cinnamon.theme")
    wm = gsettings("org.cinnamon.desktop.wm.preferences")
    portal = gsettings("org.x.apps.portal")

    p.section(_("Themen"))
    if ct:
        names = theme_names("themes", lambda d: os.path.isdir(os.path.join(d, "cinnamon")))
        p.g_combo(ct, "name", _("Schreibtisch (Cinnamon)"), [(n, n) for n in names])
    if ci:
        names = theme_names("themes", lambda d: os.path.isdir(os.path.join(d, "gtk-3.0")))
        p.g_combo(ci, "gtk-theme", _("Anwendungen (GTK)"), [(n, n) for n in names], also)
        names = theme_names("icons", is_icon_theme)
        p.g_combo(ci, "icon-theme", _("Symbole"), [(n, n) for n in names], also)
        names = theme_names("icons", lambda d: os.path.isdir(os.path.join(d, "cursors")))
        p.g_combo(ci, "cursor-theme", _("Mauszeiger"), [(n, n) for n in names], also)
        p.g_spin(ci, "cursor-size", _("Zeigergröße"), 16, 96, 1, "px", also)
    if portal:
        p.g_combo(portal, "color-scheme", _("Farbschema"),
                  [("default", _("Standard")), ("prefer-dark", _("Dunkel bevorzugen")),
                   ("prefer-light", _("Hell bevorzugen"))])

    p.section(_("Schriften"))
    if ci:
        p.g_font(ci, "font-name", _("Standardschrift"))
    if gn:
        p.g_font(gn, "document-font-name", _("Dokumentenschrift"))
        p.g_font(gn, "monospace-font-name", _("Festbreitenschrift"))
    if wm:
        p.g_font(wm, "titlebar-font", _("Fenstertitel"))
    if ci:
        w = Gtk.SpinButton.new_with_range(0.5, 3.0, 0.05)
        w.set_digits(2)
        w.set_value(ci.get_double("text-scaling-factor"))
        w.connect("value-changed", lambda w: debounce(w, lambda: ci.set_double("text-scaling-factor", w.get_value())))
        p.row(_("Textskalierung"), w)
    return p


def page_panel():
    p = Page()
    s = gsettings("org.cinnamon")
    if s:
        p.section(_("Leiste"))
        heights = s.get_strv("panels-height")
        first = heights[0].split(":") if heights else ["1", "34"]
        w = Gtk.SpinButton.new_with_range(20, 80, 1)
        w.set_value(int(first[1]) if len(first) > 1 and first[1].isdigit() else 34)

        def set_h():
            hs = s.get_strv("panels-height") or ["%s:34" % first[0]]
            hs[0] = "%s:%d" % (hs[0].split(":")[0], w.get_value_as_int())
            s.set_strv("panels-height", hs)
        w.connect("value-changed", lambda w: debounce(w, set_h, 400))
        p.row(_("Höhe") + " (px)", w)

    inst = applet_instance("calendar@cinnamon.org")
    try:
        xs = XletSettings("calendar@cinnamon.org", inst) if inst else None
    except (OSError, ValueError):
        xs = None
    if xs and "custom-format" in xs.data:
        p.section(_("Uhr"))
        sw = Gtk.Switch(active=bool(xs.get("use-custom-format")))
        sw.connect("notify::active", lambda w, _p: xs.set("use-custom-format", w.get_active()))
        p.row(_("Eigenes Uhrformat"), sw)
        for key, label, hint in (("custom-format", _("Format"), _("strftime-Platzhalter, z. B. %H:%M %a, %-d. %b")),
                                 ("custom-tooltip-format", _("Format der Kurzinfo"), None)):
            if key in xs.data:
                e = Gtk.Entry(text=xs.get(key) or "", width_chars=24)
                e.connect("changed", lambda w, k=key: debounce(w, lambda: xs.set(k, w.get_text()), 600))
                sw.bind_property("active", e, "sensitive", SYNC)
                p.row(label, e, hint)
    return p


def page_extension(uuid, title):
    p = Page()
    try:
        if uuid not in _enabled("enabled-extensions"):
            raise OSError
        xs = XletSettings(uuid, uuid)
    except (OSError, ValueError):
        p.note("%s: %s" % (title, _("Nicht installiert oder nicht aktiviert.")))
        return p
    p.xlet(xs, "extension", title)
    return p


def page_dock():
    p = Page()
    s = gsettings("net.launchpad.plank.dock.settings", PLANK_PATH)
    if not s:
        p.note(_("Dock Plank ist nicht installiert."))
        return p
    p.section(_("Dock"))
    themes = {"Default"}
    for base in (os.path.join(HOME, ".local/share/plank/themes"), "/usr/share/plank/themes"):
        try:
            themes.update(n for n in os.listdir(base) if os.path.isfile(os.path.join(base, n, "dock.theme")))
        except OSError:
            pass
    p.g_combo(s, "theme", _("Theme"), [(n, n) for n in sorted(themes, key=str.lower)])
    p.g_spin(s, "icon-size", _("Symbolgröße"), 24, 128, 2, "px")
    sw = p.g_switch(s, "zoom-enabled", _("Vergrößern beim Überfahren"))
    z = p.g_spin(s, "zoom-percent", _("Vergrößerung"), 100, 400, 10, "%")
    sw.bind_property("active", z, "sensitive", SYNC)
    p.g_combo(s, "hide-mode", _("Ausblenden"),
              [("none", _("Nie")), ("intelligent", _("Intelligent")), ("auto", _("Automatisch")),
               ("dodge-maximized", _("Bei maximiertem Fenster")), ("window-dodge", _("Bei Fenstern")),
               ("dodge-active", _("Beim aktiven Fenster"))])
    p.g_combo(s, "position", _("Position"),
              [("bottom", _("Unten")), ("top", _("Oben")), ("left", _("Links")), ("right", _("Rechts"))])
    return p


def page_background():
    p = Page()
    p.section(_("Tag/Nacht-Hintergrund"))
    conf = os.path.join(CONF_DIR, "daynight.conf")
    vals = {"CINNAMON_THEME_DAY_START": 7, "CINNAMON_THEME_NIGHT_START": 19}
    try:
        with open(conf, encoding="utf-8") as f:
            for line in f:
                k, _s, v = line.strip().partition("=")
                if k in vals and v.strip().isdigit():
                    vals[k] = int(v)
    except OSError:
        pass

    def run_now():
        helper = os.path.join(HOME, ".local/bin/cinnamon-theme-daynight")
        if os.access(helper, os.X_OK):
            subprocess.Popen([helper])

    enabled = subprocess.run(["systemctl", "--user", "is-enabled", "-q", "cinnamon-theme-daynight.timer"],
                             stderr=subprocess.DEVNULL).returncode == 0
    sw = Gtk.Switch(active=enabled)

    def toggle(w, _p):
        subprocess.run(["systemctl", "--user", "enable" if w.get_active() else "disable", "--now",
                        "cinnamon-theme-daynight.timer"], stderr=subprocess.DEVNULL)
        if w.get_active():
            run_now()
    sw.connect("notify::active", toggle)
    p.row(_("Automatisch umschalten"), sw)

    def save():
        os.makedirs(CONF_DIR, exist_ok=True)
        with open(conf, "w", encoding="utf-8") as f:
            for k, v in vals.items():
                f.write("%s=%d\n" % (k, v))
        run_now()

    for key, label in (("CINNAMON_THEME_DAY_START", _("Tag ab")), ("CINNAMON_THEME_NIGHT_START", _("Nacht ab"))):
        w = Gtk.SpinButton.new_with_range(0, 23, 1)
        w.set_value(vals[key])

        def changed(w, k=key):
            vals[k] = w.get_value_as_int()
            debounce(w, save, 600)
        w.connect("value-changed", changed)
        sw.bind_property("active", w, "sensitive", SYNC)
        p.row("%s (%s)" % (label, _("Uhr (volle Stunde)")), w)
    return p


def page_desklets():
    p = Page()
    p.section(_("Sprache"))
    lang_file = os.path.join(CONF_DIR, "desklet-language")
    try:
        with open(lang_file, encoding="utf-8") as f:
            cur = f.read().strip()
    except OSError:
        cur = ""
    w = Gtk.ComboBoxText()
    for v, t in (("auto", _("Wie System")), ("de", "Deutsch"), ("en", "English")):
        w.append(v, t)
    w.set_active_id(cur if cur in ("de", "en") else "auto")

    def changed(w):
        v = w.get_active_id()
        if v in ("de", "en"):
            os.makedirs(CONF_DIR, exist_ok=True)
            with open(lang_file, "w", encoding="utf-8") as f:
                f.write(v + "\n")
        elif os.path.exists(lang_file):
            os.remove(lang_file)
    w.connect("changed", changed)
    p.row(_("Sprache der Desklets"), w)

    for uuid, title in (("fastfetch@cinnamon-theme", _("Systeminfo")), ("sysmon@cinnamon-theme", _("Systemlast"))):
        inst = desklet_instance(uuid)
        try:
            xs = XletSettings(uuid, inst, desklet=True) if inst else None
        except (OSError, ValueError):
            xs = None
        if xs:
            p.xlet(xs, "desklet", title)
        else:
            p.note("%s: %s" % (title, _("Nicht installiert oder nicht aktiviert.")))
    return p


# ------------------------------------------------------------------ Fenster
class App(Gtk.Application):
    def __init__(self, page=None):
        super().__init__(application_id="de.little_tools.NebelEinstellungen")
        self.page = page

    def do_activate(self):
        if self.get_active_window():
            self.get_active_window().present()
            return
        win = Gtk.ApplicationWindow(application=self, title=_("Nebel-Einstellungen"))
        win.set_default_size(880, 660)
        win.set_icon_name("preferences-desktop-theme")
        hb = Gtk.HeaderBar(show_close_button=True, title=_("Nebel-Einstellungen"))
        win.set_titlebar(hb)

        start = "setup"
        stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        pages = [
            ("setup", _("Einrichtung"), page_setup),
            ("appearance", _("Darstellung"), page_appearance),
            ("panel", _("Leiste"), page_panel),
            ("menu", _("Mint-Menü"), lambda: page_extension("dock-menu@cinnamon-theme", _("Mint-Menü"))),
            ("dock", _("Dock"), page_dock),
            ("background", _("Hintergrund"), page_background),
            ("desklets", _("Desklets"), page_desklets),
            ("weather", _("Wetter"), lambda: page_extension("weather@cinnamon-theme", _("Wetter"))),
        ]
        for name, title, build in pages:
            try:
                page = build()
            except Exception as e:  # eine fehlerhafte Seite soll das Programm nicht verhindern
                page = Page()
                page.note("%s: %s" % (title, e))
            stack.add_titled(page, name, title)
            if name == "setup" and getattr(page, "set_up_done", True):
                start = "appearance"  # schon eingerichtet → gleich zu den Einstellungen
        side = Gtk.StackSidebar(stack=stack)
        side.set_size_request(170, -1)
        box = Gtk.Box()
        box.pack_start(side, False, False, 0)
        box.pack_start(stack, True, True, 0)
        win.add(box)
        win.show_all()
        stack.set_visible_child_name(self.page if self.page and stack.get_child_by_name(self.page) else start)


if __name__ == "__main__":
    # Aufruf: nebel-einstellungen [--page setup|appearance|panel|menu|dock|background|desklets|weather]
    #         nebel-einstellungen --uninstall   (alles rückgängig, wie install.sh --uninstall)
    if "--uninstall" in sys.argv:
        inst = find_installer()
        if inst:
            os.execvp("bash", ["bash", inst, "--uninstall"])
        sys.exit(_("Installationsprogramm nicht gefunden."))
    start = sys.argv[sys.argv.index("--page") + 1] if "--page" in sys.argv[:-1] else None
    App(start).run(None)
